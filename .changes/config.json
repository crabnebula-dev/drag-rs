{
  "gitSiteUrl": "https://github.com/crabnebula-dev/drag-rs/",
  "pkgManagers": {
    "javascript": {
      "version": true,
      "getPublishedVersion": {
        "use": "fetch:check",
        "options": {
          "url": "https://registry.npmjs.com/${ pkg.pkg }/${ pkg.pkgFile.version }"
        }
      },
      "publish": [
        "pnpm install",
        "pnpm build",
        "pnpm publish --access public --publish-branch v2"
      ]
    },
    "rust": {
      "version": true,
      "getPublishedVersion": {
        "use": "fetch:check",
        "options": {
          "url": "https://crates.io/api/v1/crates/${ pkg.pkgFile.pkg.package.name }/${ pkg.pkgFile.version }"
        }
      },
      "prepublish": [
        "sudo apt-get update",
        "sudo apt-get install -y webkit2gtk-4.1"
      ],
      "publish": [
        "cargo publish"
      ]
    }
  },
  "packages": {
    "@crabnebula/tauri-plugin-drag": {
      "path": "./packages/tauri-plugin-drag-api",
      "manager": "javascript"
    },
    "@crabnebula/tauri-plugin-drag-as-window": {
      "path": "./packages/tauri-plugin-drag-as-window-api",
      "manager": "javascript"
    },
    "drag": {
      "path": "./crates/drag",
      "manager": "rust"
    },
    "tauri-plugin-drag": {
      "path": "./crates/tauri-plugin-drag",
      "manager": "rust",
      "dependencies": [
        "drag"
      ]
    },
    "tauri-plugin-drag-as-window": {
      "path": "./crates/tauri-plugin-drag-as-window",
      "manager": "rust",
      "dependencies": [
        "drag"
      ]
    }
  }
}